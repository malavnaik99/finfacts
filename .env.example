# Copy to .env and fill in. .env is gitignored – never commit it.

# Required by SEC fair-access rules: app name + contact email.
SEC_USER_AGENT="FinFacts/0.1 your-email@example.com"

# Optional overrides
# SEC_MAX_RPS=8
# DATA_DIR=data

# Week 4+: BigQuery + GCS (auth via `gcloud auth application-default login`, no keys)
# GCP_PROJECT_ID=finfacts-mn-2026
# GCS_BUCKET=finfacts-mn-2026-data
# Week 6+
# HF_TOKEN=
# OPENROUTER_API_KEY=
# EVAL_MODEL=
